{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2017",
    "lib": ["es2020", "dom"],
    "module": "commonjs",
    "strict": true,
    "noImplicitOverride": true,
    // Needed for CommonJS modules.
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true, // enables importers to jump to source
    "stripInternal": true
  },
  "exclude": ["**/*.test.ts", "dist", "node_modules", "__tests__", "contract-tests"]
}
