{
  "name": "@launchdarkly/akamai-edgeworker-sdk-common",
  "version": "2.0.49",
  "homepage": "https://github.com/launchdarkly/js-core/tree/main/packages/shared/akamai-edge-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-core.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "launchdarkly",
    "akamai",
    "edge",
    "worker"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "npx jest --ci",
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "oxlint .",
    "lint:fix": "yarn run lint -- --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.5.1",
    "jest": "^29.5.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.5.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@launchdarkly/js-server-sdk-common": "^2.26.4",
    "crypto-js": "^4.1.1"
  }
}
