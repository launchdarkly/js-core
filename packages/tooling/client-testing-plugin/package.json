{
  "name": "@launchdarkly/client-testing-plugin",
  "version": "1.0.26",
  "description": "Testing plugin for LaunchDarkly client-side JavaScript SDKs. Uses the experimental plugin debug-override mechanism to inject flag values for unit tests and local development.",
  "homepage": "https://github.com/launchdarkly/js-core/tree/main/packages/tooling/client-testing-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-core.git"
  },
  "license": "Apache-2.0",
  "packageManager": "yarn@4.2.2",
  "keywords": [
    "launchdarkly",
    "test",
    "mock",
    "testing",
    "feature-flags"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./js-client-sdk": {
      "import": {
        "types": "./dist/clients/js-client-sdk.d.ts",
        "default": "./dist/clients/js-client-sdk.js"
      },
      "require": {
        "types": "./dist/clients/js-client-sdk.d.cts",
        "default": "./dist/clients/js-client-sdk.cjs"
      }
    },
    "./react-sdk": {
      "import": {
        "types": "./dist/clients/react-sdk.d.ts",
        "default": "./dist/clients/react-sdk.js"
      },
      "require": {
        "types": "./dist/clients/react-sdk.d.cts",
        "default": "./dist/clients/react-sdk.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "test": "npx jest --ci",
    "lint": "oxlint .",
    "lint:fix": "yarn run lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@launchdarkly/js-client-sdk-common": "1.34.0"
  },
  "peerDependencies": {
    "@launchdarkly/js-client-sdk": "^4.9.1",
    "@launchdarkly/react-sdk": "^4.1.4"
  },
  "peerDependenciesMeta": {
    "@launchdarkly/js-client-sdk": {
      "optional": true
    },
    "@launchdarkly/react-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@launchdarkly/js-client-sdk": "4.13.0",
    "@launchdarkly/react-sdk": "4.1.28",
    "@types/jest": "^29.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.0.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rimraf": "6.0.1",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "5.1.6"
  }
}
