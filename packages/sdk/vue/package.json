{
  "name": "@launchdarkly/vue-client-sdk",
  "version": "3.0.8",
  "description": "LaunchDarkly Client-side SDK for Vue",
  "homepage": "https://github.com/launchdarkly/js-core/tree/main/packages/sdk/vue",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-core.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "launchdarkly",
    "vue",
    "vuejs"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npx jest --ci",
    "coverage": "yarn test --coverage",
    "check": "yarn lint && yarn build && yarn test"
  },
  "dependencies": {
    "@launchdarkly/js-client-sdk": "4.13.1"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@vue/test-utils": "^2.4.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vue": "^3.4.0"
  }
}
