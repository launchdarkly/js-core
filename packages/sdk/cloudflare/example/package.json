{
  "name": "@launchdarkly/cloudflare-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "module": "./dist/index.mjs",
  "dependencies": {
    "@launchdarkly/cloudflare-server-sdk": "2.7.31"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230321.0",
    "@playwright/test": "^1.49.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "^1.49.1",
    "tsup": "^8.5.1",
    "typescript": "5.1.6",
    "wrangler": "3.114.17"
  },
  "scripts": {
    "build": "tsup",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "seed-kv": "wrangler kv key put --binding=LD_KV LD-Env-test-client-side-id --path ./src/testData.json --preview --local",
    "test": "yarn build && yarn seed-kv && playwright test",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf .yarn/cache && yarn build"
  }
}
