{
  "name": "@launchdarkly/vercel-server-sdk",
  "version": "1.3.55",
  "description": "LaunchDarkly Server-Side SDK for Vercel Edge",
  "homepage": "https://github.com/launchdarkly/js-core/tree/main/packages/sdk/vercel",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-core.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "launchdarkly",
    "vercel",
    "edge"
  ],
  "type": "module",
  "exports": {
    "require": "./dist/cjs/src/index.js",
    "import": "./dist/esm/src/index.js"
  },
  "main": "./dist/cjs/src/index.js",
  "types": "./dist/cjs/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../../scripts/build-package.sh",
    "clean": "rimraf dist",
    "tsw": "yarn tsc --watch",
    "start": "rimraf dist && yarn tsw",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest --ci --runInBand",
    "coverage": "yarn test --coverage",
    "check": "yarn lint && yarn build && yarn test"
  },
  "dependencies": {
    "@launchdarkly/js-server-sdk-common-edge": "2.6.28",
    "@vercel/edge-config": "^1.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typedoc": "0.25.0",
    "typescript": "5.1.6"
  }
}
