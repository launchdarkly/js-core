{
  "name": "@launchdarkly/electron-client-sdk",
  "version": "0.0.1",
  "description": "Electron LaunchDarkly SDK",
  "homepage": "https://github.com/launchdarkly/js-core/tree/main/packages/sdk/electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/launchdarkly/js-core.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "launchdarkly",
    "electron",
    "feature flags",
    "feature toggles",
    "feature management"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./bridge": {
      "import": {
        "types": "./dist/bridge.d.ts",
        "default": "./dist/bridge.js"
      },
      "require": {
        "types": "./dist/bridge.d.cts",
        "default": "./dist/bridge.cjs"
      }
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "require": {
        "types": "./dist/renderer.d.cts",
        "default": "./dist/renderer.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "oxlint .",
    "lint:fix": "yarn lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "jest"
  },
  "peerDependencies": {
    "electron": ">=34.5.6"
  },
  "dependencies": {
    "@launchdarkly/eventsource": "0.2.2",
    "@launchdarkly/js-client-sdk-common": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "electron": "^42.4.0",
    "jest": "^29.5.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "ts-jest": "^29.0.5",
    "tsup": "^8.5.1",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  }
}
