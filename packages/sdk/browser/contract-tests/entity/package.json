{
  "name": "@launchdarkly/browser-contract-test-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Contract test service implementation for @launchdarkly/js-client-sdk",
  "scripts": {
    "install-playwright-browsers": "playwright install --with-deps chromium",
    "start": "tsc --noEmit && vite --open=true",
    "start:headless": "tsc --noEmit && vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint ./src",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start:adapter": "sdk-testharness-server adapter"
  },
  "dependencies": {
    "@launchdarkly/js-client-sdk": "workspace:^",
    "@launchdarkly/js-contract-test-utils": "workspace:^"
  },
  "devDependencies": {
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "playwright": "^1.49.1",
    "typescript": "^5.5.3",
    "vite": "^8.0.16"
  }
}
