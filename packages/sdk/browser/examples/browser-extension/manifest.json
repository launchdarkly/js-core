{
  "manifest_version": 3,
  "name": "LaunchDarkly Browser Extension Example",
  "version": "0.0.0",
  "description": "Runs the LaunchDarkly browser SDK in a Manifest V3 extension service worker.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.launchdarkly.com/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-script.iife.js"]
    }
  ]
}
