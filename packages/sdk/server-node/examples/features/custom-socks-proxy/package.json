{
  "name": "@launchdarkly/node-server-sdk-example-custom-socks-proxy",
  "version": "0.1.0",
  "description": "Example: route the Node.js server-side SDK's traffic through a SOCKS proxy via the proxyAgent option",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "yarn build && node ./dist/index.js",
    "test": "node ./e2e/verify.mjs",
    "lint": "oxlint .",
    "lint:fix": "yarn run lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "yarn lint && yarn build"
  },
  "keywords": [
    "launchdarkly",
    "socks",
    "proxy",
    "feature-flags"
  ],
  "author": "LaunchDarkly",
  "license": "Apache-2.0",
  "dependencies": {
    "@launchdarkly/node-server-sdk": "9.13.1",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "20.1.4",
    "@types/node": "^25.9.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "5.1.6"
  }
}
