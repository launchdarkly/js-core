{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    // Required for the tsup DTS build: tsup injects the deprecated baseUrl option.
    "ignoreDeprecations": "6.0",
    // Newer langsmith releases reference NullableHeaders in internal/headers.d.mts without
    // declaring it, so their lib check fails. Remove this when langsmith fixes its typings.
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
